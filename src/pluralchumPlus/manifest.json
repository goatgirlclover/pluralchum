{
  "$schema": "https://moonlight-mod.github.io/manifest.schema.json",
  "id": "pluralchumPlus",
  "version": "1.0.1",
  "apiLevel": 2,
  "meta": {
    "name": "Pluralchum Plus",
    "tagline": "PluralKit integration for Moonlight",
    "authors": ["Ash Taylor", "Aria Givens", "leo vriska", "goatpupclover"],
    "source": "https://github.com/goatgirlclover/pluralchum/tree/moonlight-plus"
  },
  "settings": {
    "privateCommands": {
      "displayName": "Send commands in PluralKit DMs",
      "type": "boolean",
      "default": false
    },
    "doColourText": {
      "displayName": "Colored proxy text",
      "type": "boolean",
      "default": true
    },
    "useServerNames": {
      "displayName": "Use servernames",
      "type": "boolean",
      "default": true
    },
    "memberColourPref": {
      "displayName": "Default member name color",
      "type": "select",
      "options": ["Member", "System", "Role", "Theme"],
      "default": "Member"
    },
    "tagColourPref": {
      "displayName": "Default system tag color",
      "type": "select",
      "options": ["Member", "System", "Role", "Theme"],
      "default": "System"
    },
    "doDisableBanners": {
      "displayName": "Disable banners",
      "type": "boolean",
      "default": false
    },
    "doContrastTest": {
      "displayName": "Enable text contrast test",
      "type": "boolean",
      "default": true
    },
    "contrastTestColour": {
      "displayName": "Contrast test color",
      "type": "string",
      "default": "#000000"
    },
    "contrastThreshold": {
      "displayName": "Contrast ratio threshold",
      "type": "number",
      "min": 1,
      "max": 21,
      "default": 3
    },
    "unicodeFix": {
      "displayName": "Fix Unicode usernames",
      "type": "boolean",
      "default": true
    },
    "clearCache": {
      "type": "custom",
      "advice": "none"
    }
  },
  "dependencies": ["messagePopover", "spacepack"],
  "incompatible": ["pluralchum"],
  "cors": ["https://api.pluralkit.me/"]
}

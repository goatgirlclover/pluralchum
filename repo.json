[
  {
    "$schema": "https://moonlight-mod.github.io/manifest.schema.json",
    "id": "pluralchum",
    "version": "1.0.1",
    "apiLevel": 2,
    "meta": {
      "name": "Pluralchum",
      "tagline": "PluralKit integration for Moonlight",
      "authors": [
        "Ash Taylor",
        "Aria Givens",
        "leo vriska"
      ],
      "source": "https://github.com/leo60228/pluralchum/tree/moonlight"
    },
    "settings": {
      "doColourText": {
        "displayName": "Colored proxy text",
        "type": "boolean",
        "default": true
      },
      "useServerNames": {
        "displayName": "Use servernames",
        "type": "boolean",
        "default": true
      },
      "memberColourPref": {
        "displayName": "Default member name color",
        "type": "select",
        "options": [
          "Member",
          "System",
          "Role",
          "Theme"
        ],
        "default": "Member"
      },
      "tagColourPref": {
        "displayName": "Default system tag color",
        "type": "select",
        "options": [
          "Member",
          "System",
          "Role",
          "Theme"
        ],
        "default": "System"
      },
      "doDisableBanners": {
        "displayName": "Disable banners",
        "type": "boolean",
        "default": false
      },
      "doContrastTest": {
        "displayName": "Enable text contrast test",
        "type": "boolean",
        "default": true
      },
      "contrastTestColour": {
        "displayName": "Contrast test color",
        "type": "string",
        "default": "#000000"
      },
      "contrastThreshold": {
        "displayName": "Contrast ratio threshold",
        "type": "number",
        "min": 1,
        "max": 21,
        "default": 3
      }
    },
    "download": "https://leo60228.github.io/pluralchum/pluralchum.asar"
  }
]